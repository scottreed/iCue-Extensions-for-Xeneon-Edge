  "pages": [
    {
      "id": "start",
      "title": "Start here",
      "summary": "How to use this example guide.",
      "tags": [
        "intro"
      ],
      "spoilerLevel": 0,
      "minutes": 1,
      "blocks": [
        {
          "type": "text",
          "text": "Welcome to **Lantern Isle**. Begin with [Chapter 1](page:ch1), then open the [island map](map:island)."
        },
        {
          "type": "callout",
          "kind": "tip",
          "title": "Tip",
          "text": "Tick lanterns off in the [lantern list](collection:lanterns) as you find them."
        },
        {
          "type": "image",
          "asset": "lighthouse",
          "caption": "The lighthouse you are heading for."
        }
      ]
    },
    {
      "id": "ch1",
      "title": "Chapter 1: The Shore",
      "summary": "Get off the beach and find your first lantern.",
      "tags": [
        "walkthrough"
      ],
      "area": "shore",
      "spoilerLevel": 1,
      "minutes": 5,
      "blocks": [
        {
          "type": "heading",
          "text": "Leaving the beach",
          "level": 2
        },
        {
          "type": "steps",
          "items": [
            {
              "text": "Walk north along the water until you reach the pier."
            },
            {
              "text": "Pick up the shore lantern by the broken boat.",
              "itemRef": "lantern-shore"
            },
            {
              "text": "Talk to the ferryman and take the path inland."
            }
          ]
        },
        {
          "type": "callout",
          "kind": "missable",
          "text": "The shore lantern disappears once you talk to the ferryman."
        },
        {
          "type": "mapLink",
          "map": "island",
          "pin": "pin-shore",
          "label": "Show the shore lantern on the map"
        },
        {
          "type": "pageLink",
          "page": "ch2",
          "label": "Next: the lighthouse"
        }
      ]
    },
    {
      "id": "ch2",
      "title": "Chapter 2: The Lighthouse",
      "summary": "Climb the lighthouse and light the lamp.",
      "tags": [
        "walkthrough",
        "boss"
      ],
      "area": "lighthouse",
      "spoilerLevel": 2,
      "minutes": 8,
      "blocks": [
        {
          "type": "text",
          "text": "The keeper guards the top floor. Bring a [lantern](collection:lanterns) or the lamp will not light."
        },
        {
          "type": "callout",
          "kind": "boss",
          "title": "The Keeper",
          "text": "Dodge the sweeping beam, then strike while the lamp recharges."
        },
        {
          "type": "keyValue",
          "items": [
            {
              "key": "Weak to",
