{
  "author": "Scott Reed Development",
  "id": "com.scottreed.libraryplayer",
  "name": "Player for Spotify",
  "description": "Full-screen library, queue and now playing controls (Extra Large slot only)",
  "version": "0.4.4",
  "interactive": true,
  "preview_icon": "resources/icon.svg",
  "min_framework_version": "1.0.0",
  "min_app_version": "5.52",
  "os": [{ "platform": "windows" }],
  "supported_devices": [{ "type": "dashboard_lcd" }],
  "required_plugins": [
    "widgetbuilder.mediadataprovider:Media:1.1",
    "widgetbuilder.linkprovider:Url:1.0"
  ],
  "permissions": [
    { "type": "url", "domain": "api.spotify.com" },
    { "type": "url", "domain": "accounts.spotify.com" },
    { "type": "url", "domain": "scdn.co" },
    { "type": "url", "domain": "spotifycdn.com" }
  ]
}
